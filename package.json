{
  "name": "spraybot-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=@spray-paragon/web",
    "dev:api": "npm run dev --workspace=@spray-paragon/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:web": "npm run test --workspace=@spray-paragon/web",
    "test:api": "npm run test --workspace=@spray-paragon/api",
    "test:domain": "npm run test --workspace=@spray-paragon/domain",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate --workspace=@spray-paragon/api",
    "db:migrate": "npm run db:migrate --workspace=@spray-paragon/api",
    "db:seed": "npm run db:seed --workspace=@spray-paragon/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "concurrently": "^8.2.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
